[era]

	addon_id="Ageless_Era"
	addon_title="Ageless Era"
	addon_version="4.41.0"
	auto_sort=no
#textdomain wesnoth-multiplayer
	description=_"The largest era ever made featuring Default Era with the Dunefolk faction, Extended Era, Archaic Era, the Era of the Future, Eternal Era, BEEM, the Era of Four Moons, the Yokai faction, the Dark Legion, the Desert Elves, the Steelhive faction, Millennium Era, the Deep Elves, the Era of Myths, Feudal Era, Imperial Era, the Era of Strife, the Era of Magic, the Era of Chaos, Rashy Era, and Mercenaries Era."
	id="Ageless Era"
	name=_"Ageless Era"
	require_era=yes
	[load_resource]
		id="AE_required_events"
	[/load_resource]
	[event]
		name="start"
		[object]
			silent=yes
			[filter]
				name="Ravana"
			[/filter]
			[effect]
				add="AE_maintainer"
				apply_to="status"
			[/effect]
		[/object]
		[object]
			silent=yes
			[filter]
				name="Laela"
			[/filter]
			[effect]
				add="AE_maintainer"
				apply_to="status"
			[/effect]
		[/object]
		[store_unit]
			kill=no
			variable="maintainer"
			[filter]
				name="Ravana"
				[or]
					name="Laela"
				[/or]
			[/filter]
		[/store_unit]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$maintainer.length"
				name="i"
			[/variable]
			[do]
				[set_variables]
					mode="append"
					name="maintainer[$i].modifications.trait"
					[value]
#textdomain wesnoth-Ageless_Era
						description=_"$maintainer[$i].name is the maintainer of Ageless Era. Feel free to report bugs to him!"
						id="AE_maintainer"
						name=_"Maintainer"
					[/value]
				[/set_variables]
				[unstore_unit]
					find_vacant=no
					variable="maintainer[$i]"
				[/unstore_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[clear_variable]
			name="maintainer"
		[/clear_variable]
	[/event]
	[event]
		name="turn 2"
		[object]
			silent=yes
			[filter]
				name="Ravana the Night Dragon"
				[filter_wml]
					[status]
						AE_maintainer=yes
					[/status]
				[/filter_wml]
			[/filter]
			[effect]
				apply_to="image_mod"
				replace="O(0)"
			[/effect]
			[effect]
				add="BLIT(misc/water-serpent-attack-se-1_avatar.png)"
				apply_to="image_mod"
			[/effect]
		[/object]
		[object]
			silent=yes
			[filter]
				name="Laela the Snow Dragon"
				[filter_wml]
					[status]
						AE_maintainer=yes
					[/status]
				[/filter_wml]
			[/filter]
			[effect]
				apply_to="image_mod"
				replace="O(0)"
			[/effect]
			[effect]
				add="BLIT(units/monsters/water-serpent-attack-se-1.png)"
				apply_to="image_mod"
			[/effect]
			[effect]
				add="CS(120,120,160)"
				apply_to="image_mod"
			[/effect]
		[/object]
	[/event]
	[event]
		name="start"
		[get_global_variable]
			from_global="seen_changelog4_41"
			namespace="AE_"
			side="global"
			to_local="AE_seen_changelog"
		[/get_global_variable]
		[if]
			[variable]
				name="AE_seen_changelog"
				not_equals=yes
			[/variable]
			[then]
				[lua]
					code="
wesnoth.fire_event(""AE_show_changelog"")
				"
				[/lua]
				[set_variable]
					name="AE_seen_changelog"
					value=yes
				[/set_variable]
				[set_global_variable]
					from_local="AE_seen_changelog"
					immediate=yes
					namespace="AE_"
					side="global"
					to_global="seen_changelog4_41"
				[/set_global_variable]
			[/then]
		[/if]
		[clear_variable]
			name="AE_seen_changelog"
		[/clear_variable]
	[/event]
	[event]
		first_time_only=no
		name="AE_show_changelog"
		[AE_read_file]
			name="~add-ons/Ageless_Era/changelog/changelog-4.41.txt"
		[/AE_read_file]
		[message]
			caption=_"Ageless Era " +
				"4.41"
			image="portraits/me.png"
			message=_"
This era is a compilation of all the factions and eras on the add-on server. Feedback is greatly appreciated whether it be bug reports, balancing suggestions, or just your opinion of the era. (See bottom for details)" +
				_"
 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  - - - -
<span font='Times New Roman 40 bold'> UPDATES/NOTES:</span>" +
				"

$file

 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -  - - - - 
To get help you can contact <span style='oblique'>Ravana</span> on forums or you can post in the thread in the Factions and Era Development sub-forum here: http://bit.ly/AgelessEra"
			speaker="narrator"
		[/message]
	[/event]
	[event]
		first_time_only=no
		name="AE_show_changelog_menu"
		[AE_dofile]
			name="changelogs.lua"
		[/AE_dofile]
	[/event]
	[event]
		first_time_only=no
		name="prestart"
		[set_menu_item]
			description=_"Ageless unsynced menu"
			id="AE_unsynced_menu"
			synced=no
			[show_if]
				[AE_not_active]
				[/AE_not_active]
				[or]
					[Ravana]
					[/Ravana]
				[/or]
			[/show_if]
			[command]
				[fire_event]
					name="AE_show_unsynced_menu"
				[/fire_event]
			[/command]
		[/set_menu_item]
	[/event]
	[event]
		first_time_only=no
		name="Rav_Theme_Loader_on"
		[change_theme]
			theme="Rav_Theme_Loader"
		[/change_theme]
	[/event]
	[event]
		first_time_only=no
		name="Rav_Theme_Loader_off"
		[change_theme]
		[/change_theme]
	[/event]
	[event]
		first_time_only=no
		name="AE_show_unsynced_menu"
		[message]
			caption=_"Ageless Era " +
				"4.41"
			image="none"
			speaker="narrator"
			[option]
				message=_"Changelogs"
				[command]
					[fire_event]
						name="AE_show_changelog_menu"
					[/fire_event]
				[/command]
			[/option]
			[option]
				message=_"Inspect some mod settings. Other addons can register event with name=AE_show_beta_menu to be displayed."
				[command]
					[fire_event]
						name="AE_show_beta_menu"
					[/fire_event]
				[/command]
			[/option]
			[option]
				message=_"Switch to theme which gives more sidebar space to unit data"
				[command]
					[fire_event]
						name="Rav_Theme_Loader_on"
					[/fire_event]
				[/command]
			[/option]
			[option]
				message=_"Switch to default theme"
				[command]
					[fire_event]
						name="Rav_Theme_Loader_off"
					[/fire_event]
				[/command]
			[/option]
			[option]
				message=_"Return to game"
				[command]
				[/command]
			[/option]
		[/message]
	[/event]
	[event]
		name="prestart"
		[store_unit]
			kill=yes
			variable="devling_leaders"
			[filter]
				canrecruit=yes
				race="AE_myh_devling"
				type="AE_myh_Spikers,AE_myh_Staplers"
				[or]
					canrecruit=yes
					race="AE_myh2_devling"
					type="AE_myh2_Staplers"
				[/or]
			[/filter]
		[/store_unit]
		[store_unit]
			kill=yes
			variable="overgrown_devling_leaders"
			[filter]
				canrecruit=yes
				race="AE_myh_devling"
				type="AE_myh_Devling_Soldier,AE_myh_Devling_Chief,AE_myh_Grand_Devling_Chief,AE_myh_Devling_Warrior,AE_myh_Devling_Hero,AE_myh_Grand_Devling_Hero"
				[or]
					canrecruit=yes
					race="AE_myh2_devling"
					type="AE_myh2_Devling_Soldier,AE_myh2_Devling_Chief,AE_myh2_Grand_Devling_Chief,AE_myh2_Devling_Warrior,AE_myh2_Devling_Hero,AE_myh2_Grand_Devling_Hero"
				[/or]
			[/filter]
		[/store_unit]
		[store_unit]
			kill=yes
			variable="ranged_devling_leaders"
			[filter]
				canrecruit=yes
				race="AE_myh_devling"
				type="AE_myh_Blasphemists,AE_myh_Offenders,AE_myh_Abusers"
				[or]
					canrecruit=yes
					race="AE_myh2_devling"
					type="AE_myh2_Offenders,AE_myh2_Abusers"
				[/or]
			[/filter]
		[/store_unit]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$devling_leaders.length"
				name="i"
			[/variable]
			[do]
				[set_variables]
					name="temp"
					[literal]
						[trait]
							description=_"Some people are simply incredible. They seem to have an edge in every area over others. Such units benefit from all standard traits."
							female_name=_"female^legendary"
							id="legend"
							male_name=_"legendary"
							[effect]
								apply_to="attack"
								increase_damage=1
							[/effect]
							[effect]
								apply_to="movement"
								increase=1
							[/effect]
							[effect]
								apply_to="hitpoints"
								increase_total=4
							[/effect]
							[effect]
								apply_to="max_experience"
								increase="-20%"
							[/effect]
						[/trait]
					[/literal]
				[/set_variables]
				[set_variables]
					mode="append"
					name="devling_leaders[$i].modifications.trait"
					[insert_tag]
						name="literal"
						variable="temp.trait"
					[/insert_tag]
				[/set_variables]
				[clear_variable]
					name="devling_leaders[$i].max_moves,devling_leaders[$i].moves,devling_leaders[$i].max_hitpoints,devling_leaders[$i].hitpoints"
				[/clear_variable]
				[unstore_unit]
					variable="devling_leaders[$i]"
				[/unstore_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$overgrown_devling_leaders.length"
				name="i"
			[/variable]
			[do]
				[set_variables]
					name="temp"
					[literal]
						[trait]
							description=_"These Devlings are bigger than other Devlings and can withstand more punishment."
							female_name=_"female^beefy"
							id="beefy"
							male_name=_"beefy"
							[effect]
								apply_to="hitpoints"
								increase_total=2
							[/effect]
							[effect]
								apply_to="hitpoints"
								increase_total=1
								times="per level"
							[/effect]
						[/trait]
						[trait]
							description=_"Brawny Devlings hit harder, but are dumber than other Devlings."
							female_name=_"female^brawny"
							id="brawny"
							male_name=_"brawny"
							[effect]
								apply_to="attack"
								increase_damage=1
								range="melee"
							[/effect]
							[effect]
								apply_to="max_experience"
								increase="12%"
							[/effect]
						[/trait]
					[/literal]
				[/set_variables]
				[set_variables]
					mode="append"
					name="overgrown_devling_leaders[$i].modifications.trait"
					[insert_tag]
						name="literal"
						variable="temp.trait"
					[/insert_tag]
				[/set_variables]
				[clear_variable]
					name="overgrown_devling_leaders[$i].max_hitpoints,overgrown_devling_leaders[$i].hitpoints"
				[/clear_variable]
				[unstore_unit]
					variable="overgrown_devling_leaders[$i]"
				[/unstore_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$ranged_devling_leaders.length"
				name="i"
			[/variable]
			[do]
				[set_variables]
					name="temp"
					[literal]
						[trait]
							description=_"These Devlings are bigger than other Devlings and can withstand more punishment."
							female_name=_"female^beefy"
							id="beefy"
							male_name=_"beefy"
							[effect]
								apply_to="hitpoints"
								increase_total=2
							[/effect]
							[effect]
								apply_to="hitpoints"
								increase_total=1
								times="per level"
							[/effect]
						[/trait]
						[trait]
#textdomain wesnoth-help
							description=_"Fights normally during unfavorable times of day/night"
							female_name=_"female^fearless"
							help_text=_"Aversion to light and dark holds no sway over these brave individuals."
							id="fearless"
							male_name=_"fearless"
							[effect]
								apply_to="fearless"
							[/effect]
						[/trait]
					[/literal]
				[/set_variables]
				[set_variables]
					mode="append"
					name="ranged_devling_leaders[$i].modifications.trait"
					[insert_tag]
						name="literal"
						variable="temp.trait"
					[/insert_tag]
				[/set_variables]
				[clear_variable]
					name="ranged_devling_leaders[$i].max_hitpoints,ranged_devling_leaders[$i].hitpoints"
				[/clear_variable]
				[unstore_unit]
					variable="ranged_devling_leaders[$i]"
				[/unstore_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[clear_variable]
			name="temp,devling_leaders,overgrown_devling_leaders,ranged_devling_leaders"
		[/clear_variable]
	[/event]
	[event]
		first_time_only=no
		id="AE_mie_elf_placed"
		name="unit placed"
		[filter]
			race="elf"
		[/filter]
		[store_unit]
			kill=yes
			variable="MODIFY_UNIT_store"
			[filter]
				id="$unit.id"
			[/filter]
		[/store_unit]
		[foreach]
			array="MODIFY_UNIT_store"
			[do]
				[set_variable]
					name="this_item.undead_variation"
					value="elf"
				[/set_variable]
				[unstore_unit]
					find_vacant=no
					variable="this_item"
				[/unstore_unit]
			[/do]
		[/foreach]
		[clear_variable]
			name="MODIFY_UNIT_store"
		[/clear_variable]
	[/event]
