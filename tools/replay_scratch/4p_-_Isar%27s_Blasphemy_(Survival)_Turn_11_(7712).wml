															[filter]
																id="$just_advanced.id"
															[/filter]
														[/store_unit]
														[foreach]
															array="MODIFY_UNIT_store"
															[do]
																[set_variable]
																	name="this_item.variables.weapon_minus_bonus_strike_$real"
																	value="$unitweaponstrike_$real"
																[/set_variable]
																[unstore_unit]
																	find_vacant=no
																	variable="this_item"
																[/unstore_unit]
															[/do]
														[/foreach]
														[clear_variable]
															name="MODIFY_UNIT_store"
														[/clear_variable]
														[set_variable]
															name="unitstrikefunnyone"
															value="$unitweaponstrike_$real"
														[/set_variable]
														[object]
															duration="forever"
															silent=yes
															[filter]
																id="$just_advanced.id"
															[/filter]
															[effect]
																apply_to="attack"
																increase_attacks="-$unitweaponstrike_$real"
																name="$just_advanced.attack[$i].name"
																range="$just_advanced.attack[$i].range"
