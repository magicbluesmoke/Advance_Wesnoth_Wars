				[remove_unit_overlay]
					image="utils/corrode.png"
					x="$uninjure_by_healing_on[$j].x"
					y="$uninjure_by_healing_on[$j].y"
				[/remove_unit_overlay]
				[animate_unit]
					blue=200
					flag="healed"
					green=0
					red=200
					text=_"armor repaired"
					[filter]
						x="$uninjure_by_healing_on[$j].x"
						y="$uninjure_by_healing_on[$j].y"
					[/filter]
				[/animate_unit]
				[set_variable]
					add=1
					name="j"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="j"
		[/clear_variable]
		[clear_variable]
			name="uninjure_by_healing_on"
		[/clear_variable]
		[clear_variable]
