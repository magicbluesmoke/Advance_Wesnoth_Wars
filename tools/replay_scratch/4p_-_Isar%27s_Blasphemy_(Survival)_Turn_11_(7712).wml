				name="i"
			[/variable]
			[do]
				[store_unit]
					mode="append"
					variable="uninjure_by_healing_on"
					[filter]
						x="$uninjure_by_village_on[$i].x"
						y="$uninjure_by_village_on[$i].y"
					[/filter]
				[/store_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[set_variable]
			name="j"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$uninjure_by_healing_on.length"
				name="j"
			[/variable]
			[do]
				[unstore_unit]
					variable="uninjure_by_healing_on[$j]"
				[/unstore_unit]
				[modify_unit]
					[filter]
						x="$uninjure_by_healing_on[$j].x"
