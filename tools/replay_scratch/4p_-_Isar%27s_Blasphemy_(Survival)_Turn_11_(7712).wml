									[/then]
								[/if]
								[set_variable]
									add=1
									name="i"
								[/set_variable]
							[/do]
						[/while]
						[clear_variable]
							name="i"
						[/clear_variable]
						[set_variable]
							add=1
							name="real"
						[/set_variable]
					[/do]
				[/while]
				[clear_variable]
					name="real,allweaponsarediffrent"
				[/clear_variable]
				[if]
					[variable]
						name="just_advanced.minus_bonus_got2"
						not_equals="$done"
					[/variable]
					[then]
						[if]
							[variable]
								name="just_advanced.variables.minus_bonus_moves"
								not_equals="$null"
							[/variable]
							[then]
								[object]
									duration="forever"
									silent=yes
									[filter]
										id="$just_advanced.id"
									[/filter]
									[effect]
										apply_to="movement"
										increase="-$just_advanced.variables.minus_bonus_moves"
									[/effect]
								[/object]
							[/then]
						[/if]
						[if]
							[variable]
								name="just_advanced.variables.minus_bonus_hitpoints"
								not_equals="$null"
							[/variable]
							[then]
								[object]
									duration="forever"
									silent=yes
									[filter]
										id="$just_advanced.id"
									[/filter]
									[effect]
										apply_to="hitpoints"
										increase="-$just_advanced.variables.minus_bonus_hitpoints"
										increase_total="-$just_advanced.variables.minus_bonus_hitpoints"
									[/effect]
								[/object]
							[/then]
						[/if]
						[if]
							[variable]
								name="just_advanced.variables.minus_bonus_experience"
								not_equals="$null"
							[/variable]
							[then]
								[object]
									duration="forever"
									silent=yes
									[filter]
										id="$just_advanced.id"
									[/filter]
									[effect]
										apply_to="max_experience"
										increase="$just_advanced.variables.minus_bonus_experience"
										replace=no
									[/effect]
								[/object]
							[/then]
						[/if]
					[/then]
				[/if]
				[store_unit]
					kill=yes
					variable="MODIFY_UNIT_store"
					[filter]
						id="$just_advanced.id"
					[/filter]
				[/store_unit]
				[foreach]
					array="MODIFY_UNIT_store"
					[do]
						[set_variable]
							name="this_item.variables.minus_bonus_got2"
							value="done"
						[/set_variable]
						[unstore_unit]
							find_vacant=no
							variable="this_item"
						[/unstore_unit]
					[/do]
				[/foreach]
				[clear_variable]
					name="MODIFY_UNIT_store"
				[/clear_variable]
			[/then]
		[/if]
	[/event]
[event]

		first_time_only=no
		name="attacker hits"
		[filter_second]
			ability="thorns"
		[/filter_second]
		[if]
			[variable]
				less_than="$(3*$($second_unit.resistance.pierce/100))"
				name="unit.hitpoints"
			[/variable]
			[then]
				[harm_unit]
					amount=3
					animate=no
					damage_type="pierce"
					experience=yes
					fire_event=yes
					kill=no
					[filter]
						x="$x1"
						y="$y1"
					[/filter]
					[filter_second]
						x="$x2"
						y="$y2"
					[/filter_second]
				[/harm_unit]
				[store_unit]
					variable="respecer"
					[filter]
						id="unit.id"
					[/filter]
				[/store_unit]
				[set_variable]
					name="respecer.variables.may_need_respec"
					value=yes
				[/set_variable]
				[unstore_unit]
					find_vacant=no
					variable="respecer"
				[/unstore_unit]
			[/then]
			[else]
				[harm_unit]
					amount=3
					animate=no
					damage_type="pierce"
					experience=no
					fire_event=yes
					kill=no
					[filter]
						x="$x1"
						y="$y1"
					[/filter]
				[/harm_unit]
			[/else]
		[/if]
	[/event]
[event]

		first_time_only=no
		name="defender hits"
		[filter]
			ability="thorns"
		[/filter]
		[if]
			[variable]
				less_than="$(3*$($second_unit.resistance.pierce/100))"
				name="second_unit.hitpoints"
			[/variable]
			[then]
				[harm_unit]
					amount=3
					animate=no
					damage_type="pierce"
					experience=yes
					fire_event=yes
					kill=no
					[filter]
						x="$x2"
						y="$y2"
					[/filter]
				[/harm_unit]
				[fire_event]
					name="force respec"
					[primary_unit]
						id="$unit.id"
					[/primary_unit]
				[/fire_event]
			[/then]
			[else]
				[harm_unit]
					amount=3
					animate=no
					damage_type="pierce"
					experience=no
					fire_event=yes
					kill=no
					[filter]
						x="$x2"
						y="$y2"
					[/filter]
				[/harm_unit]
			[/else]
		[/if]
	[/event]
[event]

		first_time_only=no
		name="side turn"
		[store_unit]
			kill=no
			variable="units_with_freezing_aura"
			[filter]
				ability="freezing aura"
				side="$side_number"
			[/filter]
		[/store_unit]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$units_with_freezing_aura.length"
				name="i"
			[/variable]
			[do]
				[harm_unit]
					amount=4
					animate=no
					damage_type="cold"
					experience=no
					fire_event=yes
					kill=no
					slowed=yes
					[filter]
						[filter_adjacent]
							id="$units_with_freezing_aura[$i].id"
							is_enemy=yes
						[/filter_adjacent]
					[/filter]
				[/harm_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[clear_variable]
			name="units_with_freezing_aura"
		[/clear_variable]
	[/event]
[event]

		name="prestart"
		[set_variable]
			name="mod_switch_leader_version"
			value="1.1.0"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_1"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_2"
