[event]

		first_time_only=no
		id="Funny_Bonus_End"
		name="turn end"
		[if]
			[variable]
				equals=0
				name="Do_We_Do_Funny_Bonuses"
			[/variable]
			[then]
				[set_variable]
					name="SomeI"
					value=1
				[/set_variable]
				[set_variable]
					name="SomeI2"
					value=0
				[/set_variable]
				[set_variable]
					name="SomeI3"
					value=1
				[/set_variable]
				[while]
					[variable]
						less_than=10
						name="SomeI"
					[/variable]
					[do]
						[while]
							[variable]
								less_than="$How_Much_We_Do_Funny_Bonuses"
								name="SomeI2"
							[/variable]
							[do]
								[if]
									[have_unit]
										canrecruit=yes
										side="$SomeI"
									[/have_unit]
									[then]
										[if]
											[have_unit]
												side=1
												x="$Funny_Bonus_$SomeI3|_X"
												y="$Funny_Bonus_$SomeI3|_Y"
											[/have_unit]
											[or]
												[have_unit]
													side=2
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=3
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=4
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=5
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=6
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=7
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
