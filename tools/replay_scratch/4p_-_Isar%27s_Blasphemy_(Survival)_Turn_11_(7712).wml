						apply_to="hitpoints"
						increase_total="$Rav_XP_hp_amount"
					[/effect]
				[/xp_mod]
			[/command]
		[/set_menu_item]
		[set_menu_item]
			description=_"+$Rav_XP_hp_amount hp: $Rav_XP_hp_cost_drainer xp"
