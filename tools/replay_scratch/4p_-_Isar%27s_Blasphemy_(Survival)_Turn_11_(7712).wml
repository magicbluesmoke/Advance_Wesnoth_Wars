															[/filter]
															[effect]
																apply_to="attack"
																increase_damage="-$unitweapondamage_$real"
																name="$just_advanced.attack[$i].name"
																range="$just_advanced.attack[$i].range"
															[/effect]
														[/object]
														[clear_variable]
															name="unitdamagefunnyone"
														[/clear_variable]
													[/then]
												[/if]
												[if]
													[variable]
														name="unitweaponstrike_$real"
														not_equals="$null"
													[/variable]
													[and]
														[variable]
															name="just_advanced.variables.minus_bonus_got2"
															not_equals="done"
