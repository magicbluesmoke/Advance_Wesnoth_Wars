[event]

		first_time_only=no
		id="AE_RHY_drug_event_remove"
		name="turn refresh"
		[store_unit]
			mode="append"
			variable="unmedicate_start_turn"
			[filter]
				ability="AE_RHY_drugged"
				side="$side_number"
			[/filter]
		[/store_unit]
		[set_variable]
			name="j"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$unmedicate_start_turn.length"
				name="j"
			[/variable]
			[do]
				[unstore_unit]
					variable="unmedicate_start_turn[$j]"
				[/unstore_unit]
				[remove_object]
					object_id="AE_RHY_drugged_object"
					x="$unmedicate_start_turn[$j].x"
					y="$unmedicate_start_turn[$j].y"
				[/remove_object]
				[modify_unit]
					[filter]
						trait="AE_RHY_drug_trait"
						x="$unmedicate_start_turn[$j].x"
						y="$unmedicate_start_turn[$j].y"
					[/filter]
					[effect]
						apply_to="status"
						remove="unpoisonable"
					[/effect]
				[/modify_unit]
				[remove_trait]
					trait_id="AE_RHY_drug_trait"
					[filter]
						trait="AE_RHY_drug_trait"
						x="$unmedicate_start_turn[$j].x"
						y="$unmedicate_start_turn[$j].y"
					[/filter]
				[/remove_trait]
				[set_variable]
					add=1
					name="j"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="j"
		[/clear_variable]
		[clear_variable]
			name="unmedicate_start_turn"
		[/clear_variable]
	[/event]
[event]

		first_time_only=no
		id="AE_RHY_drug_event_apply"
		name="turn refresh"
		[modify_unit]
			[filter]
				side="$side_number"
				[filter_adjacent]
					ability="AE_RHY_ab_drug"
					is_enemy=no
				[/filter_adjacent]
				[not]
					ability="AE_RHY_drugged"
				[/not]
				[not]
					status="not_living"
				[/not]
			[/filter]
			[object]
				duration="forever"
				id="AE_RHY_drugged_object"
				take_only_one=no
				[effect]
					apply_to="new_ability"
					[abilities]
						[regenerate]
							description=_"This unit is taking medication, which makes them immune to poison for the duration and heals for 4 HP at start of next turn. This status is removed afterwards."
							id="AE_RHY_drugged"
							name=_"medication"
							poison="slowed"
							value=4
						[/regenerate]
					[/abilities]
				[/effect]
				[effect]
					add="utils/drugged.png"
					apply_to="overlay"
				[/effect]
			[/object]
		[/modify_unit]
		[modify_unit]
			[filter]
				side="$side_number"
				[filter_adjacent]
					ability="AE_RHY_ab_drug"
					is_enemy=no
				[/filter_adjacent]
				[not]
					status="unpoisonable"
				[/not]
			[/filter]
			[effect]
				add="unpoisonable"
				apply_to="status"
			[/effect]
			[trait]
				description=_"Immune against poison"
				help_text=_"The immune trait cancels the effect of poison. Plague and drain still apply normal."
				id="AE_RHY_drug_trait"
				name=_"immune"
			[/trait]
		[/modify_unit]
		[store_unit]
			mode="append"
			variable="animate_drug"
			[filter]
				ability="AE_RHY_drunk_1"
				side="$side_number"
			[/filter]
		[/store_unit]
		[set_variable]
			name="j"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$animate_drug.length"
				name="j"
			[/variable]
			[do]
				[unstore_unit]
					variable="animate_drug[$j]"
				[/unstore_unit]
				[animate_unit]
					blue=200
					flag="poisoned"
					green=0
					red=200
					text=_"Medicated"
					[filter]
						x="$animate_drug[$j].x"
						y="$animate_drug[$j].y"
					[/filter]
				[/animate_unit]
				[set_variable]
					add=1
					name="j"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="j"
		[/clear_variable]
		[clear_variable]
			name="animate_drug"
		[/clear_variable]
	[/event]
