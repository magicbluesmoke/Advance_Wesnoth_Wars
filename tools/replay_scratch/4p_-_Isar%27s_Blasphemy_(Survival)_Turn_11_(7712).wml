						[/set_variable]
					[/then]
				[/if]
				[set_variable]
					name="SomeI"
					value=1
				[/set_variable]
				[set_variable]
					name="SomeI2"
					value=0
				[/set_variable]
				[set_variable]
					name="SomeI3"
					value=1
				[/set_variable]
				[store_map_dimensions]
					variable="temp_map_max2"
				[/store_map_dimensions]
				[set_variable]
					add=1
					name="temp_map_max2.width"
				[/set_variable]
				[set_variable]
					add=1
					name="temp_map_max2.height"
				[/set_variable]
				[store_locations]
					variable="temp_picked_hex"
					[not]
						x="$temp_map_max2.width"
					[/not]
					[not]
						y="$temp_map_max2.height"
					[/not]
					[not]
						x=0
					[/not]
					[not]
						y=0
					[/not]
					[not]
						terrain="Wog,Wo,Wot,Qxu,Qxe,Qxua,Ql,Qlf,Mv,Xu,Xuc,Xue,Xuce,Xos,Xol,Xv,Wog^*,Wo^*,Wot^*,Mm^*,Md^*,Ms^*,Qxu^*,Qxe^*,Qxua^*,Ql^*,Qlf^*,Mv^*,Xu^*,Xuc^*,Xue^*,Xuce^*,Xos^*,Xol^*,Mm^Xm,Md^Xm,Ms^Xm,*^V*,*^Do*,_off^_usr,*^_fme,_s,_f"
					[/not]
				[/store_locations]
				[clear_variable]
					name="temp_map_max2"
				[/clear_variable]
				[while]
					[variable]
						less_than=10
						name="SomeI"
					[/variable]
					[do]
						[while]
							[variable]
								less_than="$How_Much_We_Do_Funny_Bonuses"
								name="SomeI2"
							[/variable]
							[do]
								[if]
									[have_unit]
										canrecruit=yes
										side="$SomeI"
									[/have_unit]
									[then]
										[set_variable]
											name="Funny_Bonus_Max"
											rand="100..300"
										[/set_variable]
										[set_variable]
											name="Funny_Bonus_$SomeI3|_Type"
											rand="1..$Funny_Bonus_Max"
										[/set_variable]
										[if]
											[variable]
												greater_than=80
												name="Funny_Bonus_$SomeI3|_Type"
											[/variable]
											[then]
												[clear_variable]
													name="Funny_Bonus_$SomeI3|_Type"
												[/clear_variable]
											[/then]
											[else]
												[set_variable]
													name="temp_chosen_hex"
													rand="0..$temp_picked_hex.length"
												[/set_variable]
												[set_variable]
													name="Funny_Bonus_$SomeI3|_X"
													value="$temp_picked_hex[$temp_chosen_hex].x"
												[/set_variable]
												[set_variable]
													name="Funny_Bonus_$SomeI3|_Y"
													value="$temp_picked_hex[$temp_chosen_hex].y"
												[/set_variable]
												[clear_variable]
													name="temp_chosen_hex"
												[/clear_variable]
											[/else]
										[/if]
									[/then]
								[/if]
								[if]
									[have_unit]
										canrecruit=yes
										side="$SomeI"
									[/have_unit]
									[and]
										[variable]
											less_than_equal_to=80
											name="Funny_Bonus_$SomeI3|_Type"
										[/variable]
									[/and]
									[and]
										[variable]
											name="Funny_Bonus_$SomeI3|_Type"
											not_equals="$null"
										[/variable]
									[/and]
									[then]
										[switch]
											variable="Funny_Bonus_$SomeI3|_Type"
											[case]
