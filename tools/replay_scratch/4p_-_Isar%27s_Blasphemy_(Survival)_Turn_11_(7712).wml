[event]

		first_time_only=no
		name="preload"
		[lua]
			code="
wesnoth.dofile ""~add-ons/Ageless_Era/lua/preload.lua""
"
		[/lua]
	[/event]
[event]

		name="prestart"
		[lua]
			code="
wml.variables[""era_id""] = wesnoth.scenario.era.id
"
		[/lua]
		[unit]
			placement="map"
			type="AE_mag_wesnoth_bug_3827"
		[/unit]
		[kill]
			type="AE_mag_wesnoth_bug_3827"
		[/kill]
	[/event]
[event]

		first_time_only=no
		id="AE_RHY_trapped"
		name="enter_hex"
		[filter]
			x="$x1"
			y="$y1"
			[filter_adjacent]
				ability="AE_RHY_trapping"
				is_enemy=yes
				[not]
					status="uncovered"
				[/not]
				[not]
					[filter_location]
						[filter_adjacent_location]
							x="$x2"
							y="$y2"
						[/filter_adjacent_location]
					[/filter_location]
				[/not]
				[filter_location]
					terrain="*^F*"
				[/filter_location]
				[filter_adjacent]
					count=1
					is_enemy=yes
				[/filter_adjacent]
			[/filter_adjacent]
		[/filter]
		[store_unit]
			mode="append"
			variable="AE_RHY_trapper_unit"
			[filter]
				ability="AE_RHY_trapping"
				[filter_adjacent]
					x="$x1"
					y="$y1"
				[/filter_adjacent]
				[filter_adjacent]
					count=1
					is_enemy=yes
				[/filter_adjacent]
				[not]
					status="uncovered"
				[/not]
				[not]
					[filter_location]
						[filter_adjacent_location]
							x="$x2"
							y="$y2"
						[/filter_adjacent_location]
					[/filter_location]
				[/not]
				[filter_location]
					terrain="*^F*"
				[/filter_location]
			[/filter]
		[/store_unit]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$AE_RHY_trapper_unit.length"
				name="i"
			[/variable]
			[do]
				[set_variable]
					name="AE_RHY_chance"
					rand="1..100"
				[/set_variable]
				[store_unit]
					variable="AE_RHY_trap_defender"
					[filter]
						x="$x1"
						y="$y1"
					[/filter]
				[/store_unit]
				[store_unit_defense]
					id="$AE_RHY_trap_defender.id"
					loc_x="$x1"
					loc_y="$y1"
					variable="AE_RHY_trap_defender_defense_var"
				[/store_unit_defense]
				[store_unit]
					variable="AE_RHY_trap_attacker"
					[filter]
						x="$AE_RHY_trapper_unit[$i].x"
						y="$AE_RHY_trapper_unit[$i].y"
					[/filter]
				[/store_unit]
				[if]
					[variable]
						less_than_equal_to="$AE_RHY_trap_defender_defense_var 20"
						name="AE_RHY_chance"
					[/variable]
					[then]
						[unstore_unit]
							find_vacant=no
							variable="AE_RHY_trap_attacker"
						[/unstore_unit]
						[unstore_unit]
							find_vacant=no
							variable="AE_RHY_trap_defender"
						[/unstore_unit]
						[harm_unit]
							alignment="chaotic"
							amount=10
							animate=yes
							damage_type="pierce"
							experience=yes
							fire_event=yes
							[filter]
								x="$x1"
								y="$y1"
							[/filter]
							[filter_second]
								find_in="AE_RHY_trap_attacker"
							[/filter_second]
							[primary_attack]
								name="trap"
							[/primary_attack]
						[/harm_unit]
						[modify_unit]
							[filter]
								x="$x1"
								y="$y1"
								[not]
									ability="AE_RHY_injured,AE_RHY_injured"
								[/not]
							[/filter]
							[effect]
								apply_to="new_ability"
								[abilities]
									[chance_to_hit]
										add=0
										apply_to="self"
										cumulative=yes
#textdomain wesnoth-Rashy_Era
										description=_"This unit is currently injured and has trouble to defend. This status can be healed in a village, with healing or with regenerating."
										id="AE_RHY_injured"
										name=_"injured 10%"
									[/chance_to_hit]
									[chance_to_hit]
										add=10
										apply_to="opponent"
										cumulative=yes
										description=""
										id="AE_RHY_injured"
										name=""
									[/chance_to_hit]
								[/abilities]
							[/effect]
						[/modify_unit]
						[unit_overlay]
							image="utils/injured.png"
							x="$x1"
							y="$y1"
						[/unit_overlay]
					[/then]
					[else]
						[animate_unit]
							flag="defend"
							hits=no
							[filter]
								x="$x1"
								y="$y1"
							[/filter]
							[animate]
								flag="attack"
								hits=no
								[filter]
									find_in="AE_RHY_trap_attacker"
								[/filter]
								[primary_attack]
									name="trap"
								[/primary_attack]
								[facing]
									x="$x1"
									y="$y1"
								[/facing]
							[/animate]
						[/animate_unit]
						[set_variable]
							add="$AE_RHY_trap_attacker.level"
							name="AE_RHY_trap_defender.experience"
						[/set_variable]
						[unstore_unit]
							find_vacant=no
							variable="AE_RHY_trap_defender"
						[/unstore_unit]
						[set_variable]
							add="$AE_RHY_trap_defender.level"
							name="AE_RHY_trap_attacker.experience"
						[/set_variable]
						[unstore_unit]
							find_vacant=no
							variable="AE_RHY_trap_attacker"
						[/unstore_unit]
					[/else]
				[/if]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="AE_RHY_trap_defender"
		[/clear_variable]
		[clear_variable]
			name="AE_RHY_trap_attacker"
		[/clear_variable]
		[clear_variable]
			name="AE_RHY_trapper_unit_loc"
		[/clear_variable]
		[clear_variable]
			name="AE_RHY_trapper_unit"
		[/clear_variable]
		[clear_variable]
			name="i"
		[/clear_variable]
	[/event]
[event]

		first_time_only=no
		id="AE_RHY_blur_event_attack"
		name="attacker hits"
		[filter_attack]
