		first_time_only=no
		id="AE_RHY_corrode_event_village"
		name="side turn"
		[store_locations]
			mode="append"
			terrain="*^V*"
			variable="uninjure_by_village_on"
			[filter]
				ability="AE_RHY_corroded"
				side="$side_number"
			[/filter]
		[/store_locations]
		[set_variable]
			name="i"
			value=0
