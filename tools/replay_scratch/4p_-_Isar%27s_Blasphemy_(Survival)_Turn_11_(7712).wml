[event]

		first_time_only=no
		id="AE_RHY_blur_event_remove"
		name="side turn end"
		[store_locations]
			mode="append"
			variable="unblur_end_turn"
			[filter]
				ability="AE_RHY_blurred"
				side="$side_number"
			[/filter]
		[/store_locations]
		[set_variable]
			name="i"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$unblur_end_turn.length"
				name="i"
			[/variable]
			[do]
				[store_unit]
					mode="append"
					variable="unit_to_unblur"
					[filter]
						x="$unblur_end_turn[$i].x"
						y="$unblur_end_turn[$i].y"
					[/filter]
				[/store_unit]
				[set_variable]
					add=1
					name="i"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="i"
		[/clear_variable]
		[set_variable]
			name="j"
			value=0
		[/set_variable]
		[while]
			[variable]
				less_than="$unit_to_unblur.length"
				name="j"
			[/variable]
			[do]
				[unstore_unit]
					variable="unit_to_unblur[$j]"
				[/unstore_unit]
				[modify_unit]
					[filter]
						x="$unit_to_unblur[$j].x"
						y="$unit_to_unblur[$j].y"
					[/filter]
					[effect]
						apply_to="remove_ability"
						[abilities]
							[chance_to_hit]
								add=-15
								cumulative=no
								description=_"This unit currently has a blurred vision and trouble to hit. This status is healed at the end of this units turn."
								female_name=_"blurred"
								id="AE_RHY_blurred"
								name=_"blurred"
							[/chance_to_hit]
						[/abilities]
					[/effect]
				[/modify_unit]
				[remove_unit_overlay]
					image="utils/blind.png"
					x="$unit_to_unblur[$j].x"
					y="$unit_to_unblur[$j].y"
				[/remove_unit_overlay]
				[animate_unit]
					blue=200
					flag="healed"
					green=0
					red=200
					text=_"blindness healed"
					[filter]
						x="$unit_to_unblur[$j].x"
						y="$unit_to_unblur[$j].y"
					[/filter]
				[/animate_unit]
				[set_variable]
					add=1
					name="j"
				[/set_variable]
			[/do]
		[/while]
		[clear_variable]
			name="j"
		[/clear_variable]
		[clear_variable]
			name="unit_to_unblur"
		[/clear_variable]
		[clear_variable]
			name="unblur_end_turn"
		[/clear_variable]
	[/event]
