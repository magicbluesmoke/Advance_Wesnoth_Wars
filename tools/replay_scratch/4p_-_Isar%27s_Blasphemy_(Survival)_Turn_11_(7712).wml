			name="mod_switch_leader_times_5"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_6"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_7"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_8"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_variable]
			name="mod_switch_leader_times_9"
			value="$mod_switch_leader_times"
		[/set_variable]
		[set_menu_item]
#textdomain wesnoth-Switch_Leader
			description=_"Make this unit your leader"
			id="mod_switch_leader_menu"
			[show_if]
				[have_unit]
					canrecruit=no
					side="$side_number"
					x="$x1"
					y="$y1"
				[/have_unit]
				[and]
					[variable]
						greater_than=0
						name="mod_switch_leader_times_$side_number"
					[/variable]
					[or]
						[variable]
							equals=yes
							name="mod_switch_leader_no_limit"
						[/variable]
					[/or]
				[/and]
			[/show_if]
			[command]
				[modify_unit]
					canrecruit=no
					[filter]
						canrecruit=yes
						side="$side_number"
					[/filter]
				[/modify_unit]
				[modify_unit]
					canrecruit=yes
					[filter]
						x="$x1"
						y="$y1"
					[/filter]
				[/modify_unit]
				[set_variable]
					name="mod_switch_leader_times_$side_number"
					sub=1
				[/set_variable]
			[/command]
		[/set_menu_item]
	[/event]
[event]

		first_time_only=no
		name="preload"
		[lua]
			code="
local T = wml.tag
local _ = wesnoth.textdomain ""wesnoth-XP_Modification""

function wesnoth.wml_actions.xp_mod(cfg)

	local event_context = wesnoth.current.event_context
	local unit = wesnoth.get_unit(event_context.x1, event_context.y1)

	wesnoth.play_sound(""fanfare-short.wav"")

	unit:add_modification(""object"", {
		T.effect (wml.get_child(cfg, ""effect""))
	})
	unit.experience = unit.experience - cfg.cost

    -- TRANSLATORS: Used to display a unit as ""<unit name> the <unit type>"". Example: ""Tabryn the Marshal"".
	local speaker = string.format(_(""%s the %s""), tostring(unit.name),  tostring(wesnoth.unit_types[unit.type].name))
	local message = string.format(_(""I spent %s xp for %s!""), cfg.cost,  tostring(cfg.desc))
	wesnoth.message(speaker, message)

	local floating_message = string.format(""<span color='#BCB088'>%s</span>"",  tostring(cfg.desc))
	wesnoth.float_label(unit.x, unit.y, floating_message)
end
"
		[/lua]
	[/event]
[event]

		name="turn 1"
		[set_variable]
			name="Rav_XP_hp_amount"
			value=4
		[/set_variable]
		[set_variable]
			name="Rav_XP_move_amount"
			value=1
		[/set_variable]
		[set_variable]
			name="Rav_XP_damage_amount"
			value=1
		[/set_variable]
		[set_variable]
			name="Rav_XP_strike_amount"
			value=1
		[/set_variable]
		[if]
			[variable]
				equals="$empty"
				name="Rav_XP_hp_cost"
			[/variable]
			[then]
				[set_variable]
					name="Rav_XP_hp_cost"
					value=8
				[/set_variable]
				[set_variable]
					name="Rav_XP_move_cost"
					value=8
				[/set_variable]
				[set_variable]
					name="Rav_XP_damage_cost"
					value=16
				[/set_variable]
				[set_variable]
					name="Rav_XP_strike_cost"
					value=56
				[/set_variable]
				[set_variable]
					name="Rav_XP_hp_enabled"
					value=true
				[/set_variable]
				[set_variable]
					name="Rav_XP_move_enabled"
					value=true
				[/set_variable]
				[set_variable]
					name="Rav_XP_damage_enabled"
					value=true
				[/set_variable]
				[set_variable]
					name="Rav_XP_strike_enabled"
					value=true
				[/set_variable]
			[/then]
		[/if]
		[set_variable]
			name="Rav_XP_hp_cost_drainer"
			value="$($Rav_XP_hp_cost * ($Rav_XP_drainer_penalty + 100) / 100)"
		[/set_variable]
		[set_variable]
			name="Rav_XP_move_cost_drainer"
			value="$($Rav_XP_move_cost * ($Rav_XP_drainer_penalty + 100) / 100)"
		[/set_variable]
		[set_variable]
			name="Rav_XP_damage_cost_drainer"
			value="$($Rav_XP_damage_cost * ($Rav_XP_drainer_penalty + 100) / 100)"
		[/set_variable]
		[set_variable]
			name="Rav_XP_strike_cost_drainer"
			value="$($Rav_XP_strike_cost * ($Rav_XP_drainer_penalty + 100) / 100)"
		[/set_variable]
		[set_menu_item]
#textdomain wesnoth-XP_Modification
			description=_"+$Rav_XP_hp_amount hp: $Rav_XP_hp_cost xp"
			id="xp_mod_a"
			[show_if]
				[have_unit]
					formula="experience >= $Rav_XP_hp_cost and ($Rav_XP_amla_only = 0 or ($Rav_XP_amla_only = 1 and not advances_to))"
					side="$side_number"
					x="$x1"
					y="$y1"
					[and]
						[not]
							[has_attack]
								special_type="drains"
							[/has_attack]
						[/not]
					[/and]
				[/have_unit]
			[/show_if]
			[command]
				[xp_mod]
					cost="$Rav_XP_hp_cost"
					desc="+$Rav_XP_hp_amount hp"
