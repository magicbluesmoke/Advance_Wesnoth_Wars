					[/filter]
					[effect]
						apply_to="remove_ability"
						[abilities]
							[resistance]
								affect_self=yes
								apply_to="blade,pierce,impact"
								description=_"This unit's armor is corroded and weakened against physical damage. This status can be removed in a village."
								id="AE_RHY_corroded"
								max_value=90
								name=_"corroded"
								sub=10
							[/resistance]
						[/abilities]
					[/effect]
