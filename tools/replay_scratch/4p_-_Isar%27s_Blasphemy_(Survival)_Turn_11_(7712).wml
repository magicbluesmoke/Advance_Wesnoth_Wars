													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[or]
												[have_unit]
													side=9
													x="$Funny_Bonus_$SomeI3|_X"
													y="$Funny_Bonus_$SomeI3|_Y"
												[/have_unit]
											[/or]
											[and]
												[variable]
													name="Funny_Bonus_$SomeI3|_Type"
													not_equals="$null"
												[/variable]
											[/and]
											[then]
												[switch]
													variable="Funny_Bonus_$SomeI3|_Type"
													[case]
														value="1,2"
														[object]
															duration="forever"
															silent=yes
															[filter]
																x="$Funny_Bonus_$SomeI3|_X"
																y="$Funny_Bonus_$SomeI3|_Y"
